{
  "name": "mobile-client",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync:ip": "node scripts/sync-dev-ip.js",
    "start": "node scripts/sync-dev-ip.js && expo start",
    "web": "expo start --web",
    "ios": "node scripts/sync-dev-ip.js && expo run:ios",
    "ios:device": "node scripts/sync-dev-ip.js && expo run:ios --device",
    "ios:release": "cp -f .env.prod .env && expo run:ios --device --configuration Release",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist --clear",
    "build:web:prod": "cp -f .env.prod .env.production.local && expo export --platform web --output-dir dist --clear; rm -f .env.production.local"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|react-navigation|@react-navigation/.*|react-native-svg)"
    ]
  },
  "private": true
}
